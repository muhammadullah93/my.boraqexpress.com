NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Hostinger MySQL credentials. Never commit real values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_me
DB_SSL=false

# Use at least 32 random characters in production.
SESSION_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
SESSION_TTL_HOURS=12

# Created only when no users exist. Change/remove ADMIN_PASSWORD after first boot.
ADMIN_NAME=Muhammad Ullah
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional marketplace credentials. Leave blank until official approval.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
